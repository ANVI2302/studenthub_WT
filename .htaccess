# Directory Index Priority
DirectoryIndex index.html index.php

# Protect sensitive configuration and SQL files from direct public download
<FilesMatch "^(config\.php|\.env|.*\.sql|README\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Enable UTF-8 encoding
AddDefaultCharset UTF-8
